# Complete example for a tuned local or multi-host deployment.

# Required infrastructure credentials. Keep DATABASE_URL in sync and
# URL-encode special characters in the URL.
POSTGRES_DB=endercloud
POSTGRES_USER=endercloud
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://endercloud:change-me@postgres:5432/endercloud

# Primary execution host
AGENT_ID=primary-host
AGENT_ADVERTISED_GAME_ADDRESS=192.0.2.10
AGENT_ALLOCATABLE_CPU=4
AGENT_ALLOCATABLE_MEMORY_BYTES=8589934592
AGENT_RUNTIME_LOCAL_DIRECTORY=./runtime
AGENT_RUNTIME_HOST_DIRECTORY=/absolute/path/to/EnderCloud/runtime

# Published ports
ORCHESTRATOR_PUBLISH_ADDRESS=127.0.0.1
ORCHESTRATOR_PUBLISH_PORT=8080
DASHBOARD_PUBLISH_ADDRESS=127.0.0.1
DASHBOARD_PUBLISH_PORT=3000

# Orchestrator startup worker and retry policy
INSTANCE_START_CONCURRENCY=4
INSTANCE_START_RETRY_LIMIT=5
INSTANCE_START_RETRY_BASE_DELAY=1s

# Control-loop cadence
SCHEDULER_CAPACITY_INTERVAL=5s
SCHEDULER_MATCHMAKING_INTERVAL=1s
SCHEDULER_RECONCILIATION_INTERVAL=5s
SCHEDULER_INCIDENT_INTERVAL=5s

# Remote execution calls and host health
EXECUTOR_PROBE_TIMEOUT=3s
EXECUTOR_OPERATION_TIMEOUT=10m
HOST_OFFLINE_TIMEOUT=30s

# Incident detection and retention
INCIDENT_BLOCKED_AFTER=30s
INCIDENT_FAILURE_THRESHOLD=3
INCIDENT_FAILURE_WINDOW=15m
INCIDENT_HOST_RECOVERY_AFTER=1m
INCIDENT_HISTORY_RETENTION=90d

# Structured JSON logging
ORCHESTRATOR_LOG_LEVEL=info
AGENT_LOG_LEVEL=info

# Agent identity and runtime
AGENT_VERSION=0.1.0
AGENT_HEARTBEAT_INTERVAL=5s
AGENT_GAME_PORT_START=25565
AGENT_GAME_PORT_END=25664

# Local two-agent smoke test (compose.multi-host.test.yml)
SECONDARY_AGENT_GAME_ADDRESS=192.0.2.11
SECONDARY_AGENT_CPU=4
SECONDARY_AGENT_MEMORY_BYTES=8589934592
SECONDARY_RUNTIME_HOST_ROOT=/absolute/path/to/EnderCloud/runtime-secondary
