# Base URL of the EnderCloud orchestrator. Server-side only: the browser never
# reaches the orchestrator directly. It goes through dashboard proxy routes for
# reads and the confirmed host maintenance actions.
ORCHESTRATOR_URL=http://localhost:8080

# Serve a synthetic cluster instead of proxying the orchestrator, so the console
# can be developed and demoed without Docker, PostgreSQL, Redis or a running
# orchestrator. Accepted values: 1, true, yes, on.
DASHBOARD_MOCK_DATA=false
