# Set the public origin and certificate paths before enabling this configuration.
server {
    listen 80;
    server_name dashboard.example;
    return 301 https://dashboard.example$request_uri;
}
server {
    listen 443 ssl;
    server_name dashboard.example;
    ssl_certificate /etc/letsencrypt/live/dashboard.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dashboard.example/privkey.pem;
    client_max_body_size 16k;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-Id $request_id;
        proxy_read_timeout 30s;
    }
}
