{
  "name": "@endercloud/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.0",
    "dockerode": "^4.0.9",
    "drizzle-orm": "^0.44.5",
    "elysia": "^1.4.13",
    "ioredis": "^5.8.1",
    "postgres": "^3.4.7",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/dockerode": "^3.3.44",
    "drizzle-kit": "^0.31.5",
    "typescript": "^5.9.3"
  }
}
