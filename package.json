{
  "name": "endercloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun scripts/check.ts",
    "check:release": "bun scripts/check.ts --release",
    "typecheck": "bun scripts/check.ts --types",
    "test": "bun scripts/check.ts --tests",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "dev:orchestrator": "bun run --cwd apps/orchestrator dev",
    "dev:agent": "bun run --cwd apps/agent dev",
    "dev:dashboard": "bun run --cwd apps/dashboard dev",
    "dev:web": "bun run --cwd apps/web dev"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/bun": "1.3.14"
  }
}
