{
  "name": "endercloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun scripts/check.ts",
    "check:release": "bun scripts/check.ts --release",
    "typecheck": "bun scripts/check.ts --types",
    "test": "bun scripts/check.ts --tests",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "check:docs": "bun scripts/check-docs.ts",
    "check:compose": "bun scripts/check-compose.ts",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "test:two-agents": "bun apps/orchestrator/test/smoke/two-agents.ts",
    "test:images": "bun apps/orchestrator/test/smoke/images.ts",
    "dev:orchestrator": "bun run --cwd apps/orchestrator dev",
    "dev:agent": "bun run --cwd apps/agent dev",
    "dev:dashboard": "bun run --cwd apps/dashboard dev",
    "dev:web": "bun run --cwd apps/web dev",
    "browsers:install": "bun scripts/install-browsers.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
