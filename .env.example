# Required infrastructure credentials. Keep DATABASE_URL in sync with the
# PostgreSQL values below and URL-encode special characters.
POSTGRES_DB=endercloud
POSTGRES_USER=endercloud
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://endercloud:change-me@postgres:5432/endercloud

# Primary execution host.
AGENT_ID=primary-host
AGENT_ADVERTISED_GAME_ADDRESS=192.0.2.10
AGENT_ALLOCATABLE_CPU=4
AGENT_ALLOCATABLE_MEMORY_BYTES=8589934592

# The first path is mounted by Compose. The second is the same directory as
# seen by the Docker daemon. Linux installations usually use the same value.
AGENT_RUNTIME_LOCAL_DIRECTORY=./runtime
AGENT_RUNTIME_HOST_DIRECTORY=/absolute/path/to/EnderCloud/runtime

# Control APIs stay local by default. Set a private interface when remote
# agents or operators need direct access.
ORCHESTRATOR_PUBLISH_ADDRESS=127.0.0.1
DASHBOARD_PUBLISH_ADDRESS=127.0.0.1
