POSTGRES_DB=endercloud
POSTGRES_USER=endercloud
POSTGRES_PASSWORD=endercloud
DATABASE_URL=postgres://endercloud:endercloud@postgres:5432/endercloud
REDIS_URL=redis://redis:6379
ORCHESTRATOR_PORT=8080
ORCHESTRATOR_PUBLIC_URL=http://orchestrator:8080
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_NETWORK=endercloud
GROUPS_ROOT=/data/groups
TEMPLATES_ROOT=/data/templates
RUNTIME_ROOT=/data/runtime
# Must be the absolute host path seen by the Docker daemon.
RUNTIME_HOST_ROOT=C:/absolute/path/to/EnderCloud/runtime
CAPACITY_INTERVAL_MS=5000
MATCHMAKING_INTERVAL_MS=1000
RECONCILE_INTERVAL_MS=15000
TRANSFER_TIMEOUT_MS=20000
MAX_INSTANCE_RETRIES=2
LOG_LEVEL=info
DASHBOARD_PORT=3000
ORCHESTRATOR_URL=http://orchestrator:8080
