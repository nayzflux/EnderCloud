# -----------------------------------------------------------------------------
# Docker Compose infrastructure
# -----------------------------------------------------------------------------
# Used to initialize PostgreSQL and to build the orchestrator's connection URL
# in compose.yml.
POSTGRES_DB=endercloud
POSTGRES_USER=endercloud
POSTGRES_PASSWORD=endercloud

# -----------------------------------------------------------------------------
# Orchestrator
# -----------------------------------------------------------------------------
# Direct dependency URLs. These values are mainly useful when the orchestrator
# runs outside Compose; compose.yml injects its own service-network URLs.
DATABASE_URL=postgres://endercloud:endercloud@postgres:5432/endercloud
REDIS_URL=redis://redis:6379

# Port used by the orchestrator process. compose.yml, its healthcheck and its
# published port currently assume 8080, so keep this value when using Compose.
ORCHESTRATOR_PORT=8080

# Orchestrator-owned configuration directories.
GROUPS_ROOT=/data/groups
TEMPLATES_ROOT=/data/templates

# Scheduling and reconciliation cadence, in milliseconds.
CAPACITY_INTERVAL_MS=5000
MATCHMAKING_INTERVAL_MS=1000
HOST_RECONCILE_INTERVAL_MS=5000
HOST_OFFLINE_AFTER_MS=30000

# Timeouts applied by the orchestrator when it calls an agent. Despite their
# AGENT_ prefix, these variables belong to the orchestrator process.
AGENT_PROBE_TIMEOUT_MS=3000
AGENT_OPERATION_TIMEOUT_MS=600000

# Maximum automatic restart attempts for a failed instance.
MAX_INSTANCE_RETRIES=2

# Orchestrator logging verbosity.
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Primary execution agent
# -----------------------------------------------------------------------------
# Stable identity advertised to the orchestrator. Do not change AGENT_ID after
# this host has started managing instances.
AGENT_ID=primary-host
AGENT_VERSION=0.1.0

# Agent control URL reached by the orchestrator. The main Compose stack resolves
# the agent service by this name on the endercloud network.
AGENT_PUBLIC_URL=http://agent:8090

# Private orchestrator URL reached by the primary agent. The dashboard server
# reuses it for its proxy routes.
ORCHESTRATOR_URL=http://orchestrator:8080

# Private address returned to Velocity and players for game connections.
AGENT_GAME_ADDRESS=192.0.2.10

# Resources made available to the scheduler by this host.
AGENT_CPU=4
AGENT_MEMORY_BYTES=8589934592

# Heartbeat cadence and inclusive game-port range managed by this agent.
AGENT_HEARTBEAT_INTERVAL_MS=5000
AGENT_GAME_PORT_START=25565
AGENT_GAME_PORT_END=25664

# Docker and local filesystem settings used only by the execution agent.
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_NETWORK=endercloud
RUNTIME_ROOT=/data/runtime
TEMPLATE_CACHE_ROOT=/data/template-cache

# Absolute host path as seen by the Docker daemon, not merely by the agent
# container. Docker Desktop may require its VM mount path here.
RUNTIME_HOST_ROOT=/absolute/path/to/EnderCloud/runtime

# -----------------------------------------------------------------------------
# Optional secondary agent (compose.multi-host.test.yml only)
# -----------------------------------------------------------------------------
SECONDARY_AGENT_CPU=4
SECONDARY_AGENT_MEMORY_BYTES=8589934592
SECONDARY_RUNTIME_HOST_ROOT=/absolute/path/to/EnderCloud/runtime-secondary

# -----------------------------------------------------------------------------
# Dashboard
# -----------------------------------------------------------------------------
# compose.yml publishes the dashboard on host port 3000. The browser reaches
# the orchestrator through the dashboard proxy, not through ORCHESTRATOR_URL.
