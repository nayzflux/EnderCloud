# Environment for a standalone remote agent started with compose.agent.yml.
# It contains agent inputs only; ORCHESTRATOR_URL is the endpoint the agent
# calls and is not orchestrator process configuration.

# -----------------------------------------------------------------------------
# Agent identity and control API
# -----------------------------------------------------------------------------
# Keep the id stable after this host starts managing instances.
AGENT_ID=game-paris-02
AGENT_VERSION=0.1.0

# Private URL advertised to the orchestrator, plus the host interface and port
# on which Compose publishes the agent control API.
AGENT_PUBLIC_URL=http://10.20.0.12:8090
AGENT_BIND_ADDRESS=10.20.0.12
AGENT_CONTROL_PORT=8090

# Private orchestrator endpoint reached by this agent for heartbeats, template
# downloads and instance callbacks.
ORCHESTRATOR_URL=http://10.20.0.10:8080

# -----------------------------------------------------------------------------
# Agent capacity and game traffic
# -----------------------------------------------------------------------------
# Address exposed to Velocity and players, and resources advertised to the
# orchestrator's scheduler.
AGENT_GAME_ADDRESS=10.20.0.12
AGENT_CPU=8
AGENT_MEMORY_BYTES=17179869184

# Heartbeat cadence and inclusive game-port range managed by this agent.
AGENT_HEARTBEAT_INTERVAL_MS=5000
AGENT_GAME_PORT_START=25565
AGENT_GAME_PORT_END=25664

# -----------------------------------------------------------------------------
# Agent Docker and filesystem access
# -----------------------------------------------------------------------------
DOCKER_NETWORK=endercloud

# RUNTIME_HOST_ROOT is the absolute path seen by Docker. RUNTIME_LOCAL_PATH is
# the path mounted into the agent container; both often match on a Linux host.
RUNTIME_HOST_ROOT=/srv/endercloud/runtime
RUNTIME_LOCAL_PATH=/srv/endercloud/runtime

# Agent logging verbosity.
LOG_LEVEL=info
